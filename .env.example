# Token GitHub (scope: public_repo albo bez żadnego scope'u).
# Bez tokenu aplikacja działa wyłącznie na danych z seeda - pula core dla
# anonimowych żądań to 60/h, a jeden przebieg zużywa ~100 (SPEC §4.1).
GITHUB_TOKEN=

# Hasło do Postgresa w compose. Wymagane, compose bez niego nie wstanie.
POSTGRES_PASSWORD=gittez

# Migracje EF przy starcie API.
APPLY_MIGRATIONS=true

# Wczytanie db/seed/repo_cache_seed.sql po migracjach (SPEC §8.1).
SEED_ON_STARTUP=true

# Scalar i /openapi pod adresem API. Poza środowiskiem deweloperskim nie
# włączają się same, compose ustawia to jawnie na potrzeby dema.
ENABLE_API_DOCS=true
